{
  "name": "@profiterol/blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for page-builder blocks: schema, defaults and validation",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/mark-cjs.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
