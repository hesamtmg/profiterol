# Postgres
POSTGRES_USER=profiterol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=profiterol

# API
DATABASE_URL=postgres://profiterol:change-me@localhost:5432/profiterol
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
UPLOAD_DIR=./uploads
# Migrations run on start. true = build tables straight from the entities instead (quick local experiments only)
DB_SYNC=false

# Optional: email form messages, invitations and password resets. SMTP_URL=log prints emails to the API log instead.
SMTP_URL=
SMTP_FROM="Profiterol <no-reply@example.com>"
# The site's public address, used in emailed links. "Forgot password?" emails need it.
SITE_URL=http://localhost
# Only for a front end on another domain: comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=

# Web (server-side calls go straight to the API container; browser calls go through nginx)
NUXT_API_INTERNAL=http://localhost:3001/api
NUXT_PUBLIC_API_BASE=/api

# nginx public port
HTTP_PORT=80
