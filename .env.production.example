# Copy to .env on the server and fill in every value marked "change me".
# docker-compose.prod.yml refuses to start while a required value is missing.

# Your domain (DNS A/AAAA records must point at this server before requesting certificates)
DOMAIN=example.com
# Other names that should redirect to DOMAIN, space-separated, e.g. "www.example.com"
EXTRA_DOMAINS=""
# Let's Encrypt sends expiry warnings here
LETSENCRYPT_EMAIL=you@example.com

# Database (change me: a long random password, e.g. openssl rand -hex 24)
POSTGRES_USER=profiterol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=profiterol

# API (change me: openssl rand -hex 32)
JWT_SECRET=change-me
# First admin account, created on the first start only. Change the password after logging in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Optional: email form messages (address is set in Admin → Site settings), invitations and password resets.
# Without it, admins pass password links on by hand (Admin → Users → Password link).
SMTP_URL=
SMTP_FROM="Profiterol <no-reply@example.com>"

# Images: built by GitHub Actions. TAG=latest, or a commit SHA to pin or roll back.
API_IMAGE=ghcr.io/hesamtmg/profiterol-api
WEB_IMAGE=ghcr.io/hesamtmg/profiterol-web
TAG=latest

# Backups: cron schedule (container time), days to keep, time zone
BACKUP_CRON="30 2 * * *"
BACKUP_KEEP_DAYS=14
TZ=Asia/Tehran
