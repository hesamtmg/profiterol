# nginx behind the shared Oblivion reverse proxy (github.com/hesamtmg/Oblivion), used by
# docker-compose.oblivion.yml. Oblivion owns ports 80/443 on the server and terminates HTTPS;
# it forwards every request for every site's address here over the shared "oblivion" Docker
# network (nginx/conf.d/profiterol-sites.conf, written by the domains agent from Admin → Sites).
# The app picks the site from the address, so every name is served; Oblivion only sends known ones,
# and redirects www. and other aliases to the main address itself.
# Everything else is the same as prod/default.conf.template: uploads served from the volume,
# security headers, the "back in a moment" page. No TLS, no certbot, no published ports.

# Browsers that accept AVIF get the AVIF copy of a photo when one has been made (see the WebP location below).
map $http_accept $avif {
  default "";
  "~*image/avif" ".avif";
}

# Look containers up through Docker's DNS on every request (cached 10s) rather than once at start-up,
# so containers recreated by an update are found at their new addresses.
resolver 127.0.0.11 valid=10s ipv6=off;
# By their unique names (docker-compose.oblivion.yml): this nginx is also on the shared "oblivion" network, where
# other projects' containers may be called "api" or "web" too.
map $host $api_upstream { default http://profiterol-api:3001; }
map $host $web_upstream { default http://profiterol-web:3000; }

# The visitor's real address: trust X-Forwarded-For from Oblivion (private Docker addresses only).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;

# Whether the visitor came over HTTPS, as Oblivion saw it: sites without a certificate yet are served over plain
# HTTP, and the app must know (secure cookies, links). Without the header, HTTPS as before.
map $http_x_forwarded_proto $visitor_proto {
  default $http_x_forwarded_proto;
  "" https;
}

server {
  listen 80 default_server;
  server_name _;
  server_tokens off;

  # Docker health check; only ever answers "ok".
  location = /nginx-health {
    access_log off;
    return 200 'ok';
  }

  client_max_body_size 25m;

  include /etc/nginx/snippets/security-headers.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

  # Sized copies of photos: answered with the smaller AVIF copy when the browser accepts it and it exists.
  location ~ "^/uploads/(?<copy>[\w-]+-\d+)\.webp$" {
    root /data;
    types { image/webp webp; image/avif avif; }
    expires 30d;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, immutable";
    add_header Vary Accept;
    add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'" always;
    try_files /uploads/$copy$avif /uploads/$copy.webp =404;
  }

  location /uploads/ {
    alias /data/uploads/;
    expires 30d;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, immutable";
    add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'" always;
    try_files $uri =404;
  }

  # While the site or API restarts (a few seconds during an update), show a friendly page
  # with 503 + Retry-After instead of nginx's bare "502 Bad Gateway".
  error_page 502 504 =503 /_unavailable.html;
  location = /_unavailable.html {
    root /usr/share/nginx/errors;
    internal;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Retry-After 10 always;
    add_header Cache-Control "no-store" always;
  }

  # The API clears the web app's page cache directly, not through here.
  location /_cache/ {
    return 404;
  }

  location /api/ {
    proxy_pass $api_upstream;
    include /etc/nginx/snippets/oblivion-proxy.conf;
  }

  location /_nuxt/ {
    proxy_pass $web_upstream;
    include /etc/nginx/snippets/oblivion-proxy.conf;
    include /etc/nginx/snippets/security-headers.conf;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    proxy_pass $web_upstream;
    include /etc/nginx/snippets/oblivion-proxy.conf;
  }
}
